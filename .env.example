# Copier en .env puis changer le mot de passe (8 caractères minimum)
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=admin

# Utilisé par les scripts Python
MINIO_ENDPOINT=http://localhost:9000

